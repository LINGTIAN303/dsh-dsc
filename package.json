{
  "name": "dsh-dsc",
  "version": "0.1.0",
  "description": "DeepSeek 对话界面复刻（对齐官网页版 chat.deepseek.com）：联网搜索、深度思考、阅读链接、文件输入、语音输入与朗读。DSH 插件。",
  "type": "module",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "LINGTIAN303",
  "homepage": "https://github.com/LINGTIAN303/dsh-deepseek-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LINGTIAN303/dsh-deepseek-chat.git"
  },
  "bugs": {
    "url": "https://github.com/LINGTIAN303/dsh-deepseek-chat/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "chat"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/app.css",
    "lib/config.js",
    "lib/credential.js",
    "lib/data-dir.js",
    "lib/deepseek-api.js",
    "lib/llm-api.js",
    "lib/search.js",
    "lib/session-store.js",
    "lib/settings-store.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "prismjs": "1.30.0"
  }
}
